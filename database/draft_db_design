CREATE TABLE IF NOT EXISTS trecipes (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  title TEXT NOT NULL,
  description TEXT
)

CREATE TABLE IF NOT EXISTS tingredients (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL
)

CREATE TABLE IF NOT EXISTS tsteps (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  recipe_id INTEGER NOT NULL,
  step_number INTEGER NOT NULL,
  content TEXT,
  FOREIGN KEY (recipe_id) REFERENCES trecipes (id)
)

CREATE TABLE IF NOT EXISTS tstep_ingredient (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  step_id INTEGER NOT NULL,
  ingredient_id INTEGER,
  FOREIGN KEY (step_id) REFERENCES tsteps (id),
  FOREIGN KEY (ingredient_id) REFERENCES tingredients (id)
)
